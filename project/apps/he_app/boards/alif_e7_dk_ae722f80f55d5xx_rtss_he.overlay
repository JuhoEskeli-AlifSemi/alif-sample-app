&pinctrl {
	pinctrl_eth0: pinctrl_eth0 {
		#pinctrl-state-cells = <0>;
		#pinctrl-cells = <1>;
		group0 {
			pinmux = <
			PIN_P6_0__ETH_TXD0_A
			PIN_P10_5__ETH_TXD1_B
			PIN_P10_6__ETH_TXEN_B
			PIN_P11_0__ETH_REFCLK_B
			PIN_P11_1__ETH_MDIO_B
			PIN_P11_2__ETH_MDC_B
			PIN_P11_3__ETH_RXD0_B
			PIN_P11_4__ETH_RXD1_B
			PIN_P11_5__ETH_CRS_DV_B
			PIN_P11_6__ETH_RST_B
			PIN_P11_7__ETH_IRQ_B
			>;
		};
	};
};

/ {
	aliases {
		ethernet0 = &eth_alif;
	};

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		
		ethphy: ethernet-phy@1 {
			reg = <1>;
			compatible = "ethernet-phy-ieee802.3-c22";
			micrel,led-mode = <1>;
		};
	};

    eth_alif: ethernet@48100000 {
		compatible = "zephyr,eth-alif";
		reg = <0x48100000 0x10000>;  /* Base address + size */
		interrupt-parent = <&nvic>;
		interrupts = <148 0>;  /* ETH_SBD_IRQ */
		status = "okay";
		label = "eth_alif";
		mac-address = [00 16 3E 11 22 33];
		pinctrl-0 = <&pinctrl_eth0>;
		pinctrl-names = "default";
		phy-handle = <&ethphy>;
	};

    dma_sram: sram@08000000{
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x08000000 0x00010000>;
		zephyr,memory-region = "ETH_DMA";
	};
};

&flash_storage {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		/* LFS image partitions */
		data_partition_he: partition@0 {
			label = "data_partition_he";
			reg = <0x00000000 DT_SIZE_M(1)>;
		};
		data_partition_hp: partition@100000 {
			label = "data_partition_hp";
			reg = <0x00100000 DT_SIZE_M(1)>;
		};
	};
};

&ospi1 {
	pinctrl-0 = <&pinctrl_flash>;
	status = "okay";
};

/ {
	fstab {
		compatible = "zephyr,fstab";
		lfshe: lfshe {
			compatible = "zephyr,fstab,littlefs";
			read-size = <32>;
			prog-size = <32>;
			cache-size = <256>;
			lookahead-size = <64>;
			block-cycles = <10000>;// 10k cycles
			partition = <&data_partition_he>;
			mount-point = "/data";
		};
	};
};