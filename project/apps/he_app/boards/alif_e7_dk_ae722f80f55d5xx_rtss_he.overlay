&flash_storage {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		/* LFS image partitions */
		data_partition_he: partition@0 {
			label = "data_partition_he";
			reg = <0x00000000 DT_SIZE_M(1)>;
		};
		data_partition_hp: partition@100000 {
			label = "data_partition_hp";
			reg = <0x00100000 DT_SIZE_M(1)>;
		};
	};
};

/ {
	aliases {
		spi-flash0 = &ospi_flash;
	};
};

&ospi1 {
	pinctrl-0 = <&pinctrl_flash>;
	status = "okay";
};

/ {
	fstab {
		compatible = "zephyr,fstab";
		lfshe: lfshe {
			compatible = "zephyr,fstab,littlefs";
			read-size = <32>;
			prog-size = <32>;
			cache-size = <256>;
			lookahead-size = <64>;
			block-cycles = <10000>;// 10k cycles
			partition = <&data_partition_he>;
			mount-point = "/data";
		};
	};
};